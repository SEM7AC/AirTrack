@page "/mx"
@using AirTrack.Server.Data
@using AirTrack.Server.Models.Aircraft
@using AirTrack.Server.Models.Maintenance
@using AirTrack.Server.Components.UI.MX
@rendermode InteractiveServer
@inject DbHelper Db

<div class="mx-container">

    <div class="mx-top">

        <!-- LEFT PANEL -->
        <div class="mx-list-panel">

            <h2 class="mx-title">Maintenance</h2>

            <div class="search-box">
                <input type="text"
                       placeholder="Search by tail number or model..."
                       @bind="SearchText"
                       @bind:event="oninput" />
            </div>

            <ul class="mx-aircraft-list">
                @foreach (var a in FilteredAircraft)
                {
                    <li class="mx-aircraft-item @(selectedAircraft is not null && selectedAircraft.Id == a.Id ? "selected" : "")"
                        @onclick="() => SelectAircraft(a.Id)">
                        <div class="name">@a.TailNumber</div>
                        <div class="sub">@a.Model</div>
                    </li>
                }
            </ul>

        </div>

        <!-- RIGHT PANEL -->
        <div class="mx-detail-panel">

            <div class="mx-detail-top">

                <!-- LEFT SIDE: AC INFO + MAINTENANCE + SQUAWKS -->
                <div class="mx-top-left">
                    @if (selectedAircraft is not null)
                    {
                        <h3 class="mx-section-title">@selectedAircraft.TailNumber</h3>

                        <div class="mx-ac-info">
                            <div>Model: @selectedAircraft.Model</div>
                            <div>Hobbs: @selectedAircraft.Hobbs</div>
                            <div>Tach: @selectedAircraft.Tach</div>
                            <div>Annual Due: @selectedAircraft.AnnualDueDate.ToShortDateString()</div>
                            <div>Open Squawks: @selectedAircraft.SquawkCount</div>
                        </div>

                        <button class="mx-button" @onclick="OpenMxEditor">
                            Edit MX Info
                        </button>

                        <!-- DERIVED AIRCRAFT MAINTENANCE PANELS -->
                        @if (selectedAircraft is CessnaSkyhawk skyhawk)
                        {
                            <CessnaSkyhawkMaintenancePanel Aircraft="skyhawk" />
                        }
                        else if (selectedAircraft is PiperArrow arrow)
                        {
                            <PiperArrowMaintenancePanel Aircraft="arrow" />
                        }
                        else if (selectedAircraft is PiperSeminole seminole)
                        {
                            <PiperSeminoleMaintenancePanel Aircraft="seminole" />
                        }
                        else if (selectedAircraft is RobinsonR44 r44)
                        {
                            <RobinsonR44MaintenancePanel Aircraft="r44" />
                        }

                        <h4 class="mx-subsection-title">Open Squawks</h4>

                        <div class="mx-open-squawks">
                            @if (openSquawks is null)
                            {
                                <div class="mx-muted">Select an aircraft.</div>
                            }
                            else if (openSquawks.Count == 0)
                            {
                                <div class="mx-muted">No open squawks.</div>
                            }
                            else
                            {
                                foreach (var s in openSquawks)
                                {
                                    <div class="mx-squawk-item"
                                         @onclick="() => SelectSquawk(s)">
                                        <strong class="mx-squawk-desc">@s.Description</strong>
                                        <div class="mx-squawk-date">
                                            Reported: @s.ReportedAt.ToShortDateString()
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>

                <!-- RIGHT SIDE: ADD SQUAWK -->
                <div class="mx-top-right">
                    @if (selectedAircraft is not null)
                    {
                        <h3 class="mx-section-title">Add Squawk</h3>

                        <label class="mx-field-label">Description</label>
                        <input type="text"
                               class="mx-input"
                               placeholder="Squawk description"
                               @bind="newSquawkText" />

                        <label class="mx-checkbox-label">
                            <input type="checkbox" @bind="newSquawkIsGrounding" />
                            Grounding?
                        </label>

                        <button class="mx-button" @onclick="AddSquawk">Add Squawk</button>
                    }
                </div>

            </div>

            <!-- BOTTOM: RESOLVE -->
            <div class="mx-detail-bottom">
                @if (selectedAircraft is not null && selectedSquawk is not null)
                {
                    <h3 class="mx-section-title">Resolve Squawk</h3>

                    <label class="mx-field-label">Resolution Notes</label>
                    <textarea class="mx-input"
                              placeholder="Resolution notes"
                              @bind="resolutionNotes"></textarea>

                    <label class="mx-field-label">Mechanic Signoff</label>
                    <input type="text"
                           class="mx-input"
                           placeholder="Mechanic signoff"
                           @bind="mechanicSignoff" />

                    <button class="mx-button" @onclick="ResolveSquawk">Resolve</button>
                }
            </div>

        </div>

    </div>

</div>

@if (showMxEditor && selectedAircraft is not null)
{
    <div class="mx-slideout">
        <div class="mx-slideout-content">

            <h3>Edit MX Info — @selectedAircraft.TailNumber</h3>

            @if (selectedAircraft is CessnaSkyhawk skyhawk)
            {
                <CessnaSkyhawkMaintenanceEditor Aircraft="skyhawk" />
            }
            else if (selectedAircraft is PiperArrow arrow)
            {
                <PiperArrowMaintenanceEditor Aircraft="arrow" />
            }
            else if (selectedAircraft is PiperSeminole seminole)
            {
                <PiperSeminoleMaintenanceEditor Aircraft="seminole" />
            }
            else if (selectedAircraft is RobinsonR44 r44)
            {
                <RobinsonR44MaintenanceEditor Aircraft="r44" />
            }

            <button class="mx-button" @onclick="() => showMxEditor = false">
                Close
            </button>

        </div>
    </div>
}


@code {
    private List<AircraftBase>? aircraft;
    private AircraftBase? selectedAircraft;
    private List<Squawk>? openSquawks;

    private Squawk? selectedSquawk;

    private string newSquawkText = string.Empty;
    private bool newSquawkIsGrounding = false;
    private bool showMxEditor = false;

    private string resolutionNotes = string.Empty;
    private string mechanicSignoff = string.Empty;

    private string SearchText = "";

    private IEnumerable<AircraftBase> FilteredAircraft =>
        aircraft?.Where(a =>
            string.IsNullOrWhiteSpace(SearchText) ||
            a.TailNumber.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
            a.Model.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
        ) ?? Enumerable.Empty<AircraftBase>();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        aircraft = await Db.GetAllAircraft();
    }

    private async Task SelectAircraft(int id)
    {
        selectedAircraft = await Db.GetAircraft(id);
        openSquawks = await Db.GetOpenSquawks(id);
        selectedSquawk = null;
    }

    private void SelectSquawk(Squawk s)
    {
        selectedSquawk = s;
        resolutionNotes = string.Empty;
        mechanicSignoff = string.Empty;
    }

    private async Task AddSquawk()
    {
        if (string.IsNullOrWhiteSpace(newSquawkText) || selectedAircraft is null)
            return;

        var squawk = new Squawk
        {
            AircraftId = selectedAircraft.Id,
            Description = newSquawkText,
            IsGrounding = newSquawkIsGrounding,
            ReportedAt = DateTime.UtcNow
        };

        await Db.AddSquawk(squawk);

        newSquawkText = string.Empty;
        newSquawkIsGrounding = false;

        openSquawks = await Db.GetOpenSquawks(selectedAircraft.Id);
    }

    private async Task ResolveSquawk()
    {
        if (selectedSquawk is null || selectedAircraft is null)
            return;

        await Db.ResolveSquawk(
            selectedSquawk.Id,
            resolutionNotes,
            mechanicSignoff);

        resolutionNotes = string.Empty;
        mechanicSignoff = string.Empty;

        openSquawks = await Db.GetOpenSquawks(selectedAircraft.Id);
        selectedSquawk = null;
    }

    private void OpenMxEditor()
    {
        if (selectedAircraft is null)
            return;

        showMxEditor = true;
    }
}
