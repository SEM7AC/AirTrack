@page "/mechanics"
@rendermode InteractiveServer
@using AirTrack.Server.Data
@using AirTrack.Server.Models.People

@inject DbHelper Db

<div class="mechanics-container">

    <!-- LEFT LIST PANEL -->
    <div class="list-panel">
        <div class="header">
            <h2>Mechanics</h2>

            <div class="actions">
                <button type="button" @onclick="ShowAddPanel">Add Mechanic</button>
            </div>
        </div>

        <!-- SEARCH BAR -->
        <div class="search-box">
            <input type="text"
                   placeholder="Search by name or email..."
                   @bind="SearchText"
                   @bind:event="oninput" />
        </div>

        <ul class="mechanic-list">
            @foreach (var m in FilteredMechanics)
            {
                <li class="@(SelectedMechanic?.Id == m.Id ? "selected" : "")"
                    @onclick="() => SelectMechanic(m)">
                    <div class="name">@m.FirstName @m.LastName</div>
                    <div class="sub">@m.Email</div>
                </li>
            }
        </ul>
    </div>

    <!-- RIGHT PANEL -->
    <div class="detail-panel">

        @if (ActivePanel == "add")
        {
            <h3>Add Mechanic</h3>

            <EditForm Model="AddModel" OnValidSubmit="AddMechanic">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label>First Name</label>
                    <InputText @bind-Value="AddModel.FirstName" />
                    <ValidationMessage For="@(() => AddModel.FirstName)" />
                </div>

                <div class="form-row">
                    <label>Last Name</label>
                    <InputText @bind-Value="AddModel.LastName" />
                    <ValidationMessage For="@(() => AddModel.LastName)" />
                </div>

                <div class="form-row">
                    <label>Email</label>
                    <InputText @bind-Value="AddModel.Email" />
                    <ValidationMessage For="@(() => AddModel.Email)" />
                </div>

                <div class="form-row">
                    <label>Phone</label>
                    <InputText @bind-Value="AddModel.Phone" />
                </div>

                <div class="form-row">
                    <label>Certification Number</label>
                    <InputText @bind-Value="AddModel.CertificationNumber" />
                    <ValidationMessage For="@(() => AddModel.CertificationNumber)" />
                </div>

                <div class="form-row">
                    <label>Hire Date</label>
                    <InputDate @bind-Value="AddModel.HireDate" />
                </div>

                <div class="form-row">
                    <label>Status</label>
                    <InputSelect @bind-Value="AddModel.Status">
                        @foreach (var value in Enum.GetValues<PersonStatus>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </div>

                <button type="submit">Save</button>
                <button type="button" @onclick="ClearPanel">Cancel</button>
            </EditForm>
        }

        @if (ActivePanel == "edit" && SelectedMechanic is not null)
        {
            <h3>Edit Mechanic</h3>

            <EditForm Model="EditModel" OnValidSubmit="UpdateMechanic">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label>First Name</label>
                    <InputText @bind-Value="EditModel.FirstName" />
                    <ValidationMessage For="@(() => EditModel.FirstName)" />
                </div>

                <div class="form-row">
                    <label>Last Name</label>
                    <InputText @bind-Value="EditModel.LastName" />
                    <ValidationMessage For="@(() => EditModel.LastName)" />
                </div>

                <div class="form-row">
                    <label>Email</label>
                    <InputText @bind-Value="EditModel.Email" />
                    <ValidationMessage For="@(() => EditModel.Email)" />
                </div>

                <div class="form-row">
                    <label>Phone</label>
                    <InputText @bind-Value="EditModel.Phone" />
                </div>

                <div class="form-row">
                    <label>Certification Number</label>
                    <InputText @bind-Value="EditModel.CertificationNumber" />
                    <ValidationMessage For="@(() => EditModel.CertificationNumber)" />
                </div>

                <div class="form-row">
                    <label>Hire Date</label>
                    <InputDate @bind-Value="EditModel.HireDate" />
                </div>

                <div class="form-row">
                    <label>Status</label>
                    <InputSelect @bind-Value="EditModel.Status">
                        @foreach (var value in Enum.GetValues<PersonStatus>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </div>

                <button type="submit">Save</button>
                <button type="button" @onclick="DeleteMechanic">Delete</button>
                <button type="button" @onclick="ClearPanel">Cancel</button>
            </EditForm>
        }

    </div>

</div>

@code {

    private List<Mechanic> MechanicsData = new();
    private Mechanic? SelectedMechanic;

    private Mechanic AddModel = new();
    private Mechanic EditModel = new();

    private string ActivePanel = "";
    private string SearchText = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadMechanics();
    }

    private async Task LoadMechanics()
    {
        MechanicsData = await Db.GetAllMechanics();
    }

    private IEnumerable<Mechanic> FilteredMechanics =>
        MechanicsData.Where(m =>
            string.IsNullOrWhiteSpace(SearchText) ||
            m.FirstName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
            m.LastName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
            m.Email.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
        );

    private void SelectMechanic(Mechanic m)
    {
        SelectedMechanic = m;

        EditModel = new Mechanic
        {
            Id = m.Id,
            FirstName = m.FirstName,
            LastName = m.LastName,
            Email = m.Email,
            Phone = m.Phone,
            CertificationNumber = m.CertificationNumber,
            HireDate = m.HireDate,
            Status = m.Status
        };

        ActivePanel = "edit";
    }

    private void ShowAddPanel()
    {
        AddModel = new Mechanic
        {
            HireDate = DateTime.Now,
            Status = PersonStatus.Active
        };

        ActivePanel = "add";
    }

    private async Task AddMechanic()
    {
        await Db.AddMechanic(AddModel);
        await LoadMechanics();
        ClearPanel();
    }

    private async Task UpdateMechanic()
    {
        if (SelectedMechanic is null)
            return;

        EditModel.Id = SelectedMechanic.Id;

        await Db.UpdateMechanic(EditModel);
        await LoadMechanics();
        ClearPanel();
    }

    private async Task DeleteMechanic()
    {
        if (SelectedMechanic is null)
            return;

        await Db.DeleteMechanic(SelectedMechanic.Id);
        await LoadMechanics();
        ClearPanel();
    }

    private void ClearPanel()
    {
        SelectedMechanic = null;
        AddModel = new();
        EditModel = new();
        ActivePanel = "";
    }
}
