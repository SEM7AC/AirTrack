@page "/aircraft/add"
@rendermode InteractiveServer
@using AirTrack.Server.Models.Aircraft
@using AirTrack.Server.Data
@using AirTrack.Server.Models.FormModel
@inject DbHelper Db

<div class="add-layout">

    <!-- Sidebar -->
    <div class="sidebar">
    <h3 class="sidebar-title">Added This Session</h3>

    <div class="session-list-scroll">
        @foreach (var ac in SessionAircraft)
        {
            <div class="session-item">
                <div class="tail">@ac.TailNumber</div>
                <div class="model">@ac.Model</div>
            </div>
        }
    </div>
</div>

    <!-- Main content -->
    <div class="content">
        <div class="add-card">

            <h2>Add Aircraft</h2>

            <EditForm Model="@FormModel" OnValidSubmit="@HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <div class="form-group">
                        <label>Tail Number</label>
                        <InputText @bind-Value="FormModel.TailNumber" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Aircraft Type</label>
                        <InputSelect @bind-Value="SelectedModel" class="form-select">
                            <option value="">-- Select Model --</option>
                            <option value="C172">Cessna 172 Skyhawk</option>
                            <option value="PA28R">Piper PA-28R Arrow</option>
                            <option value="PA44">Piper PA-44 Seminole</option>
                            <option value="R44">Robinson R44</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Hobbs</label>
                        <InputNumber @bind-Value="FormModel.Hobbs" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>Tach</label>
                        <InputNumber @bind-Value="FormModel.Tach" class="form-control" />
                    </div>
                </div>

                <div class="form-group full">
                    <label>Annual Due Date</label>
                    <InputDate @bind-Value="FormModel.AnnualDueDate" class="form-control" />
                </div>

                <div class="form-group full">
                    <label>Status</label>
                    <InputSelect @bind-Value="FormModel.Status" class="form-select">
                        @foreach (var s in Enum.GetValues<AircraftStatus>())
                        {
                            <option value="@s">@s</option>
                        }
                    </InputSelect>
                </div>

                <button type="submit" class="save-btn">Add Aircraft</button>
            </EditForm>

        </div>
    </div>

</div>

@code {
    private AircraftFormModel FormModel = new();
    private string SelectedModel { get; set; } = string.Empty;
    private List<AircraftBase> SessionAircraft = new(); // Session list

    private async Task HandleSubmit()
        {
        AircraftBase aircraft = SelectedModel switch
            {
                "C172" => new CessnaSkyhawk { Model = "Cessna 172 Skyhawk" },
                "PA28R" => new PiperArrow { Model = "Piper PA-28R Arrow" },
                "PA44" => new PiperSeminole { Model = "Piper PA-44 Seminole" },
                "R44" => new RobinsonR44 { Model = "Robinson R44" },
                _ => throw new Exception("Invalid aircraft model selected.")
                };

        aircraft.TailNumber = FormModel.TailNumber;
        aircraft.Hobbs = FormModel.Hobbs;
        aircraft.Tach = FormModel.Tach;
        aircraft.AnnualDueDate = FormModel.AnnualDueDate;
        aircraft.Status = FormModel.Status;

        await Db.AddAircraft(aircraft);

        Console.WriteLine($"Added aircraft: {aircraft.TailNumber} ({SelectedModel})");

        // Add to session list
        SessionAircraft.Add(aircraft);

        // Reset form
        FormModel = new AircraftFormModel();
        SelectedModel = string.Empty;

    }
}
