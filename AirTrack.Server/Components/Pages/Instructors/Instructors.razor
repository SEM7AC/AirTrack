@page "/instructors"
@rendermode InteractiveServer
@using AirTrack.Server.Data
@using AirTrack.Server.Models.People

@inject DbHelper Db

<div class="instructors-container">

    <!-- LEFT LIST PANEL -->
    <div class="list-panel">
        <div class="header">
            <h2>Instructors</h2>

            <div class="actions">
                <button type="button" @onclick="ShowAddPanel">Add Instructor</button>
            </div>
        </div>

        <!-- SEARCH BAR -->
        <div class="search-box">
            <input type="text"
                   placeholder="Search by name or email..."
                   @bind="SearchText"
                   @bind:event="oninput" />
        </div>

        <ul class="instructor-list">
            @foreach (var i in FilteredInstructors)
            {
                <li class="@(SelectedInstructor?.Id == i.Id ? "selected" : "")"
                    @onclick="() => SelectInstructor(i)">
                    <div class="name">@i.FirstName @i.LastName</div>
                    <div class="sub">@i.Email</div>
                </li>
            }
        </ul>
    </div>

    <!-- RIGHT PANEL -->
    <div class="detail-panel">

        @if (ActivePanel == "add")
        {
            <h3>Add Instructor</h3>

            <EditForm Model="AddModel" OnValidSubmit="AddInstructor">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label>First Name</label>
                    <InputText @bind-Value="AddModel.FirstName" />
                    <ValidationMessage For="@(() => AddModel.FirstName)" />
                </div>

                <div class="form-row">
                    <label>Last Name</label>
                    <InputText @bind-Value="AddModel.LastName" />
                    <ValidationMessage For="@(() => AddModel.LastName)" />
                </div>

                <div class="form-row">
                    <label>Email</label>
                    <InputText @bind-Value="AddModel.Email" />
                    <ValidationMessage For="@(() => AddModel.Email)" />
                </div>

                <div class="form-row">
                    <label>Phone</label>
                    <InputText @bind-Value="AddModel.Phone" />
                </div>

                <div class="form-row">
                    <label>Certifications</label>
                    <InputText @bind-Value="AddModel.Certifications" />
                </div>

                <div class="form-row">
                    <label>Hire Date</label>
                    <InputDate @bind-Value="AddModel.HireDate" />
                </div>

                <div class="form-row">
                    <label>Status</label>
                    <InputSelect @bind-Value="AddModel.Status">
                        @foreach (var value in Enum.GetValues<PersonStatus>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </div>

                <button type="submit">Save</button>
                <button type="button" @onclick="ClearPanel">Cancel</button>
            </EditForm>
        }

        @if (ActivePanel == "edit" && SelectedInstructor is not null)
        {
            <h3>Edit Instructor</h3>

            <EditForm Model="EditModel" OnValidSubmit="UpdateInstructor">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label>First Name</label>
                    <InputText @bind-Value="EditModel.FirstName" />
                </div>

                <div class="form-row">
                    <label>Last Name</label>
                    <InputText @bind-Value="EditModel.LastName" />
                </div>

                <div class="form-row">
                    <label>Email</label>
                    <InputText @bind-Value="EditModel.Email" />
                </div>

                <div class="form-row">
                    <label>Phone</label>
                    <InputText @bind-Value="EditModel.Phone" />
                </div>

                <div class="form-row">
                    <label>Certifications</label>
                    <InputText @bind-Value="EditModel.Certifications" />
                </div>

                <div class="form-row">
                    <label>Hire Date</label>
                    <InputDate @bind-Value="EditModel.HireDate" />
                </div>

                <div class="form-row">
                    <label>Status</label>
                    <InputSelect @bind-Value="EditModel.Status">
                        @foreach (var value in Enum.GetValues<PersonStatus>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                </div>

                <button type="submit">Save</button>
                <button type="button" @onclick="DeleteInstructor">Delete</button>
                <button type="button" @onclick="ClearPanel">Cancel</button>
            </EditForm>
        }

    </div>

</div>

@code {

    private List<Instructor> InstructorsData = new();
    private Instructor? SelectedInstructor;

    private Instructor AddModel = new();
    private Instructor EditModel = new();

    private string ActivePanel = "";
    private string SearchText = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadInstructors();
    }

    private async Task LoadInstructors()
    {
        InstructorsData = await Db.GetAllInstructors();
    }

    private IEnumerable<Instructor> FilteredInstructors =>
        InstructorsData.Where(i => i.MatchesSearch(SearchText));


    private void SelectInstructor(Instructor i)
    {
        SelectedInstructor = i;

        EditModel = i.Clone();


        ActivePanel = "edit";
    }

    private void ShowAddPanel()
    {
        AddModel = Instructor.CreateNew();

        ActivePanel = "add";
    }

    private async Task AddInstructor()
    {
        AddModel.ApplyNormalization();
        await Db.AddInstructor(AddModel);
        await LoadInstructors();
        ClearPanel();

    }

    private async Task UpdateInstructor()
    {
        if (SelectedInstructor is null)
            return;

        EditModel.Id = SelectedInstructor.Id;
        EditModel.ApplyNormalization();

        await Db.UpdateInstructor(EditModel);
        await LoadInstructors();
        ClearPanel();
    }

    private async Task DeleteInstructor()
    {
        if (SelectedInstructor is null)
            return;

        await Db.DeleteInstructor(SelectedInstructor.Id);
        await LoadInstructors();
        ClearPanel();
    }

    private void ClearPanel()
    {
        SelectedInstructor = null;
        AddModel = Instructor.CreateNew();
        EditModel = Instructor.CreateNew();

        ActivePanel = "";
    }
}
