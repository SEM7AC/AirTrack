@page "/"
@rendermode InteractiveServer
@using AirTrack.Server.Components.UI;
@using AirTrack.Server.Models.Aircraft
@using AirTrack.Server.Data;
@using AirTrack.Server.Models.Scheduler
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore;
@inject DbHelper Db

<PageTitle>AirTrack - Dashboard</PageTitle>

@if (AircraftList is null)
{
    <p>Loading...</p>
}
else if (AircraftList.Count == 0)
{
    <p>No aircraft found.</p>
}
else
{
    <div class="aircraft-list">
        <div class="aircraft-grid">
            @foreach (var plane in AircraftList)
            {
                <AircraftCard @key="plane.Id" Aircraft="plane" OnUpdateHobbs="OpenHobbsModal"/>

            }
        </div>
    </div>
}

@if (HobbsModalVisible && SelectedAircraft is not null)
{
    <div class="modal-backdrop">
        <div class="modal">
            <h3>Update Hobbs</h3>

            <div class="modal-row">
                <label>Old Hobbs</label>
                <input type="number" value="@SelectedAircraft.Hobbs" readonly />
            </div>

            <div class="modal-row">
                <label>New Hobbs</label>
                <input type="number" @bind="NewHobbs" step="0.1" />
            </div>

            @if (!IsHobbsValid)
            {
                <div class="error">New Hobbs must be greater than old Hobbs.</div>
            }

            <div class="modal-actions">
                <button @onclick="SaveHobbs" disabled="@(NewHobbs is null || !IsHobbsValid)">Save</button>
                <button @onclick="() => HobbsModalVisible = false">Cancel</button>
            </div>
        </div>
    </div>
}
@code {
    private List<AircraftBase> AircraftList = new();
    private List<FlightEvent> Events = new();

    private bool HobbsModalVisible;
    private AircraftBase? SelectedAircraft;
    private decimal? NewHobbs;


    private System.Timers.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData(); // loads BEFORE first render
    }


    protected override Task OnAfterRenderAsync(bool firstRender)
    {
    if (firstRender)
    {
        _timer = new System.Timers.Timer(15000);
        _timer.Elapsed += async (_, _) =>
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        };

        _timer.AutoReset = true;
        _timer.Start();
    }
    return Task.CompletedTask;
}

    private async Task LoadData()
    {
        try
        {
            AircraftList = await Db.GetAllAircraft();
            Events = await Db.GetAllEvents();

            foreach (var plane in AircraftList)
            {
                plane.SquawkCount = await Db.GetOpenSquawksCount(plane.Id); //check before grounding condition

                if (await Db.AircraftHasGroundingSquawk(plane.Id))
                {
                    plane.Status = AircraftStatus.Maintenance;
                    continue;
                }
                
                plane.Status = GetStatus(plane); //If not MX then Get Status
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Dashboard load error: " + ex.Message);
        }
    }

    int InFlightCount => AircraftList.Count(a => IsInFlight(a));
    int ScheduledCount => AircraftList.Count(a => IsScheduled(a));

    bool IsInFlight(AircraftBase a)
    {
        var now = DateTime.Now;
        return Events.Any(e =>
            e.AircraftId == a.Id &&
            e.Start <= now &&
            e.End >= now
        );
    }

    bool IsScheduled(AircraftBase a)
    {
        var now = DateTime.Now;
        return Events.Any(e =>
            e.AircraftId == a.Id &&
            e.Start > now
        );
    }

    private AircraftStatus GetStatus(AircraftBase a)
{
    var now = DateTime.Now;

    // 1. Maintenance due (hobbs or calendar)
    if (IsMaintenanceDue(a))
        return AircraftStatus.Maintenance;

    // 2. InFlight?
    var active = Events.FirstOrDefault(e =>
        e.AircraftId == a.Id &&
        e.Start <= now &&
        e.End >= now);

    if (active != null)
    {
        a.CurrentFlightStart = active.Start;

        var next = Events.FirstOrDefault(e => e.AircraftId == a.Id && e.Start > now);
        a.NextBookingStart = next?.Start;
        a.NextBookingEnd = next?.End;

        return AircraftStatus.InFlight;
    }

    // 3. Scheduled?
    var future = Events.FirstOrDefault(e =>
        e.AircraftId == a.Id &&
        e.Start > now);

    if (future != null)
    {
        a.NextBookingStart = future.Start;
        a.NextBookingEnd = future.End;

        return AircraftStatus.Scheduled;
    }

    // 4. Available
    return AircraftStatus.Available;
}


    void OpenHobbsModal(AircraftBase aircraft)
    {
        SelectedAircraft = aircraft;
        NewHobbs = null;
        HobbsModalVisible = true;
    }

    private bool IsHobbsValid =>
    NewHobbs is not null &&
    SelectedAircraft is not null &&
    NewHobbs > SelectedAircraft.Hobbs;

    async Task SaveHobbs()
    {
        if (!IsHobbsValid || SelectedAircraft is null)
            return;

        
        SelectedAircraft.Hobbs = NewHobbs!.Value;
        await Db.UpdateAircraft(SelectedAircraft);

        HobbsModalVisible = false;
    }

    private bool IsMaintenanceDue(AircraftBase a)
{
    var hobbs = a.Hobbs;
    var now = DateTime.Now;

    switch (a)
    {
        case CessnaSkyhawk s:
            if (hobbs >= s.LastOilChange + 50) return true;
            if (hobbs >= s.Last50Hr + 50) return true;
            if (hobbs >= s.Last100Hr + 100) return true;

            if (s.ELTInspectionDue is not null && s.ELTInspectionDue <= now) return true;
            if (s.TransponderDue is not null && s.TransponderDue <= now) return true;
            if (s.PitotStaticDue is not null && s.PitotStaticDue <= now) return true;

            return false;

        case PiperArrow pa:
            if (hobbs >= pa.LastOilChange + 50) return true;
            if (hobbs >= pa.Last100Hr + 100) return true;

            if (pa.LastGearCyclesInspection >= 200) return true;

            if (pa.PropOverhaulDue is not null && pa.PropOverhaulDue <= now) return true;

            return false;

        case PiperSeminole ps:
            if (hobbs >= ps.LastLeftEngineHobbs + 50) return true;
            if (hobbs >= ps.LastRightEngineHobbs + 50) return true;
            if (hobbs >= ps.Last100Hr + 100) return true;

            if (ps.LastGearCyclesInspection >= 200) return true;

            if (ps.LeftPropOverhaulDue is not null && ps.LeftPropOverhaulDue <= now) return true;
            if (ps.RightPropOverhaulDue is not null && ps.RightPropOverhaulDue <= now) return true;

            return false;

        case RobinsonR44 r:
            if (hobbs >= r.Last2200HrOverhaul + 2200) return true;

            if (r.BladeLifeRemaining <= 0) return true;

            if (r.ClutchActuationCount >= 200) return true;

            if (r.GovernorInspectionDue is not null && r.GovernorInspectionDue <= now) return true;

            return false;

        default:
            return false;
    }
}




}

