@page "/students"
@rendermode InteractiveServer
@using AirTrack.Server.Data
@using AirTrack.Server.Models.People

@inject DbHelper Db

<div class="students-container">

    <!-- LEFT LIST PANEL -->
    <div class="list-panel">
        <div class="header">
            <h2>Students</h2>

            <div class="actions">
                <button type="button" @onclick="ShowAddPanel">Add Student</button>
            </div>
        </div>

        <!-- SEARCH BAR (Aircraft-style) -->
        <div class="search-box">
            <input type="text"
                   placeholder="Search by name or email..."
                   @bind="SearchText"
                   @bind:event="oninput" />
        </div>

        <ul class="student-list">
            @foreach (var s in FilteredStudents)
            {
                <li class="@(SelectedStudent?.Id == s.Id ? "selected" : "")"
                    @onclick="() => SelectStudent(s)">
                    <div class="name">@s.FirstName @s.LastName</div>
                    <div class="sub">@s.Email</div>
                </li>
            }
        </ul>
    </div>

    <!-- RIGHT PANEL -->
    <div class="detail-panel">

        @if (ActivePanel == "add")
        {
            <h3>Add Student</h3>

            <EditForm Model="AddModel" OnValidSubmit="AddStudent">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label for="fn">First Name</label>
                    <InputText id="fn" @bind-Value="AddModel.FirstName" />
                    <ValidationMessage For="@(() => AddModel.FirstName)" />
                </div>

                <div class="form-row">
                    <label for="ln">Last Name</label>
                    <InputText id="ln" @bind-Value="AddModel.LastName" />
                    <ValidationMessage For="@(() => AddModel.LastName)" />
                </div>

                <div class="form-row">
                    <label for="em">Email</label>
                    <InputText id="em" @bind-Value="AddModel.Email" />
                    <ValidationMessage For="@(() => AddModel.Email)" />
                </div>

                <div class="form-row">
                    <label for="ph">Phone</label>
                    <InputText id="ph" @bind-Value="AddModel.Phone" />
                    <ValidationMessage For="@(() => AddModel.Phone)" />
                </div>

                <div class="form-row">
                    <label for="ed">Enrollment Date</label>
                    <InputDate id="ed" @bind-Value="AddModel.EnrollmentDate" />
                    <ValidationMessage For="@(() => AddModel.EnrollmentDate)" />
                </div>

                <div class="form-row">
                    <label for="st">Status</label>
                    <InputSelect id="st" @bind-Value="AddModel.Status">
                        @foreach (var value in Enum.GetValues<PersonStatus>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => AddModel.Status)" />
                </div>

                <button type="submit">Save</button>
                <button type="button" @onclick="ClearPanel">Cancel</button>
            </EditForm>
        }

        @if (ActivePanel == "edit" && SelectedStudent is not null)
        {
            <h3>Edit Student</h3>

            <EditForm Model="EditModel" OnValidSubmit="UpdateStudent">
                <DataAnnotationsValidator />

                <div class="form-row">
                    <label for="fn2">First Name</label>
                    <InputText id="fn2" @bind-Value="EditModel.FirstName" />
                    <ValidationMessage For="@(() => EditModel.FirstName)" />
                </div>

                <div class="form-row">
                    <label for="ln2">Last Name</label>
                    <InputText id="ln2" @bind-Value="EditModel.LastName" />
                    <ValidationMessage For="@(() => EditModel.LastName)" />
                </div>

                <div class="form-row">
                    <label for="em2">Email</label>
                    <InputText id="em2" @bind-Value="EditModel.Email" />
                    <ValidationMessage For="@(() => EditModel.Email)" />
                </div>

                <div class="form-row">
                    <label for="ph2">Phone</label>
                    <InputText id="ph2" @bind-Value="EditModel.Phone" />
                    <ValidationMessage For="@(() => EditModel.Phone)" />
                </div>

                <div class="form-row">
                    <label for="ed2">Enrollment Date</label>
                    <InputDate id="ed2" @bind-Value="EditModel.EnrollmentDate" />
                    <ValidationMessage For="@(() => EditModel.EnrollmentDate)" />
                </div>

                <div class="form-row">
                    <label for="st2">Status</label>
                    <InputSelect id="st2" @bind-Value="EditModel.Status">
                        @foreach (var value in Enum.GetValues<PersonStatus>())
                        {
                            <option value="@value">@value</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => EditModel.Status)" />
                </div>

                <button type="submit">Save</button>
                <button type="button" @onclick="DeleteStudent">Delete</button>
                <button type="button" @onclick="ClearPanel">Cancel</button>
            </EditForm>
        }

    </div>

</div>

@code {

    private List<Student> StudentsData = new();
    private Student? SelectedStudent;

    private Student AddModel = new();
    private Student EditModel = new();

    private string ActivePanel = "";
    private string SearchText = "";

    protected override async Task OnInitializedAsync()
        {
        await LoadStudents();
        }

    private async Task LoadStudents()
        {
        StudentsData = await Db.GetAllStudents();
        }

    private IEnumerable<Student> FilteredStudents =>
        StudentsData.Where(s => s.MatchesSearch(SearchText));

    private void SelectStudent(Student s)
        {
        SelectedStudent = s;
        EditModel = s.Clone();        

        ActivePanel = "edit";
    }

    private void ShowAddPanel()
    {
        AddModel = Student.CreateNew();
        ActivePanel = "add";
    }

    private async Task AddStudent()
{
    AddModel.ApplyNormalization();
    await Db.AddStudent(AddModel);
    await LoadStudents();
    ClearPanel();
}

    private async Task UpdateStudent()
{
    if (SelectedStudent is null)
        return;

    EditModel.Id = SelectedStudent.Id;
    EditModel.ApplyNormalization();

    await Db.UpdateStudent(EditModel);
    await LoadStudents();
    ClearPanel();
}

    private async Task DeleteStudent()
    {
        if (SelectedStudent is null)
            return;

        await Db.DeleteStudent(SelectedStudent.Id);
        await LoadStudents();
        ClearPanel();
    }

    private void ClearPanel()
    {
        SelectedStudent = null;
        AddModel = new();
        EditModel = new();
        ActivePanel = "";
    }
}
