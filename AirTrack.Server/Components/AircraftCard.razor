@using AirTrack.Model
@using AirTrack.Model.Aircraft

<div class="aircraft-card">
    <div class="aircraft-type-tail">
        @((MarkupString)$"{Aircraft.Model}&nbsp;&nbsp;•&nbsp;&nbsp;{Aircraft.TailNumber}")


    </div>

    <div class="aircraft-next">
        Next: @(Aircraft.NextBookingStart?.ToString("HH:mm") ?? "—")
    </div>

    <div class="aircraft-status @GetStatusClass(Aircraft.Status.ToString())">
        Status: @Aircraft.Status
    </div>

    <div class="aircraft-hobbs">
        Hobbs: @Aircraft.Hobbs
    </div>

    <div class="aircraft-squawks">
        Squawks: @Aircraft.SquawkCount
    </div>
</div>




@code {
    [Parameter]
    public AircraftBase Aircraft { get; set; } = null!;

    private string GetStatusClass(string status) =>
        status.ToLower() switch
        {
            "available"   => "status-available",
            "inflight"    => "status-inflight",
            "scheduled"   => "status-scheduled",
            "maintenance" => "status-mx",
            _             => "status-unknown"
        };
}



