@using AirTrack.Server.Models.Aircraft

<div class="aircraft-card">
    <div class="aircraft-type-tail">
        @((MarkupString)$"{Aircraft.Model.GetDescription()}&nbsp;&nbsp;•&nbsp;&nbsp;{Aircraft.TailNumber}")


    </div>

    @if (Aircraft.NextBookingStart is not null && Aircraft.NextBookingEnd is not null)
{
    <div class="aircraft-next">
        Next: @(Aircraft.NextBookingStart.Value.ToString("HHmm"))-@(Aircraft.NextBookingEnd.Value.ToString("HHmm"))
    </div>
}
    else
    {
        <div class="aircraft-next">
            Next: —
        </div>
    }

    <div class="aircraft-status @GetStatusClass(Aircraft.Status.ToString())">
        Status: @Aircraft.Status
    </div>

    <div class="aircraft-hobbs">
        Hobbs: @Aircraft.Hobbs
    </div>

    <div class="aircraft-squawks">
        Squawks: @Aircraft.SquawkCount
    </div>

    <div class="hobbs-button">
        <button @onclick="() => OnUpdateHobbs.InvokeAsync(Aircraft)">Update Hobbs</button>
    </div>

</div>




@code {
    [Parameter]
    public AircraftBase Aircraft { get; set; } = null!;
    [Parameter] 
    public EventCallback<AircraftBase> OnUpdateHobbs { get; set; }

    private string GetStatusClass(string status) =>
        status.ToLower() switch
        {
            "available"   => "status-available",
            "inflight"    => "status-inflight",
            "scheduled"   => "status-scheduled",
            "maintenance" => "status-mx",
            _             => "status-unknown"
        };
}



