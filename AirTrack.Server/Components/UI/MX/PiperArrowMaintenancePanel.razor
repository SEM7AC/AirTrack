@using AirTrack.Server.Models.Aircraft

@code {
    [Parameter] public PiperArrow? Aircraft { get; set; }
}

<div class="mx-maint-panel">
    <h4>Piper Arrow Maintenance</h4>

    <div>Oil Change (hrs): @Aircraft?.LastOilChange</div>
    <div>100 Hr Insp (hrs): @Aircraft?.Last100Hr</div>
    <div>Gear Cycles Since Insp: @Aircraft?.LastGearCyclesInspection</div>

    <div>Prop Overhaul Due: @(Aircraft?.PropOverhaulDue?.ToShortDateString() ?? "N/A")</div>

    <h5>Recurring ADs</h5>
    @if (Aircraft?.RecurringADs is not null && Aircraft.RecurringADs.Count > 0)
    {
        <ul>
            @foreach (var ad in Aircraft.RecurringADs)
            {
                <li>
                    <strong>@ad.ADNumber</strong> — @ad.Description  
                    (Last: @ad.LastCompliedWith?.ToShortDateString() ?? "N/A")
                </li>
            }
        </ul>
    }
    else
    {
        <div class="mx-muted">No recurring ADs.</div>
    }
</div>
