    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<EnableDefaultScopedCssItems>true</EnableDefaultScopedCssItems>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Components\AircraftCard.razor.css" />
    <None Remove="Components\Test.razor.css" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Components\AircraftCard.razor.css" />
    <Content Include="Components\Test.razor.css" />
  </ItemGroup>
	  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.28" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.28" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>

</Project>
